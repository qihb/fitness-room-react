{
  "name": "fitness-room-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "preview": "vp preview",
    "test": "vp test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "depcruise": "depcruise --config .dependency-cruiser.cjs \"src/**/*.{ts,tsx}\"",
    "cpd": "jscpd src",
    "lhci": "lhci autorun",
    "prepare": "vp config"
  },
  "dependencies": {
    "@ant-design/icons": "catalog:",
    "antd": "catalog:",
    "axios": "catalog:",
    "dayjs": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@lhci/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "dependency-cruiser": "catalog:",
    "jscpd": "catalog:",
    "puppeteer-core": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "~6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.11.0",
      "onFail": "error"
    }
  }
}
